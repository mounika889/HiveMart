PORT=5000
NODE_ENV=development

# Database Configuration (Aiven PostgreSQL)
DATABASE_URL=postgresql://avnadmin:your_password@pg-service-name.aivencloud.com:27628/defaultdb?sslmode=require

# Optional: Path to custom CA certificate or PEM content (defaults to certs/ca.pem)
# AIVEN_CA_CERT=certs/ca.pem

# OpenSearch Configuration (Aiven OpenSearch)
OPENSEARCH_URL=https://avnadmin:your_password@os-service-name.aivencloud.com:27628

# Optional: Custom CA certificate for OpenSearch if not using standard public CA (defaults to system CA store)
# OPENSEARCH_CA_CERT=certs/opensearch-ca.pem

# Authentication (JWT)
# Generate a secure 256-bit key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Kafka Configuration (Aiven Kafka)
KAFKA_BROKERS=kafka-service-name.aivencloud.com:27641
KAFKA_USERNAME=avnadmin
KAFKA_PASSWORD=your_kafka_password
KAFKA_CLIENT_ID=hivemart-backend
KAFKA_ORDERS_TOPIC=hivemart.orders

# Transactional Outbox Publisher Configuration
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=2000

# Kafka Consumer Configuration (OpenSearch Search Sync)
KAFKA_SEARCH_SYNC_GROUP=hivemart-search-sync-v1

# Optional: Path to custom CA certificate for Kafka (defaults to certs/ca.pem)
# KAFKA_CA_CERT=certs/ca.pem
